{
  "manifest_version": 3,
  "name": "Assistente de Registro de Aulas",
  "version": "2.0.0",
  "description": "Login local e preenchimento de registros de aula no portal SEDUC-PI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://portal.seduc.pi.gov.br/*", "https://seduc-academico-prod.seduc.pi.gov.br/*"],
  "content_scripts": [{"matches": ["https://portal.seduc.pi.gov.br/*", "https://seduc-academico-prod.seduc.pi.gov.br/*"], "js": ["portal.js", "confirmation.js", "profile.js", "wizard.js", "fill.js", "batch.js"], "run_at": "document_idle", "all_frames": true}],
  "action": { "default_popup": "popup.html", "default_title": "Registro de aulas" }
}
